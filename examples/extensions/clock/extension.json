{
  "format": 1,
  "id": "clock",
  "version": "1.0.0",
  "name": "Clock",
  "description": "Minimal example: the current time in any time zone.",
  "author": "XeonLLM",
  "servers": {
    "clock": {
      "command": "{python}",
      "args": [
        "-I",
        "-B",
        "{extension}/server.py"
      ],
      "timeout_ms": 10000
    }
  },
  "settings": [
    {
      "id": "clock",
      "title": "Clock",
      "fields": [
        {
          "key": "XEON_CLOCK_DEFAULT_ZONE",
          "kind": "text",
          "placeholder": "Europe/Madrid",
          "title": "Default zone",
          "help": "IANA zone used when the question names none."
        }
      ]
    }
  ]
}
