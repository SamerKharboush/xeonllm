{
  "format": 1,
  "id": "places",
  "version": "1.0.0",
  "name": "Places",
  "description": "Complete example: capitals, mountains, landmarks and places of your own, distances between them and a map, answered by an agent of its own.",
  "author": "XeonLLM",
  "servers": {
    "places": {
      "command": "{python}",
      "args": [
        "-I",
        "-B",
        "{extension}/server.py"
      ],
      "timeout_ms": 20000,
      "enabled_by": "XEON_PLACES_ENABLED",
      "agent_only": true
    }
  },
  "agent": {
    "command": "{python}",
    "args": [
      "-I",
      "-B",
      "{extension}/agent.py"
    ],
    "timeout_ms": 900000
  },
  "settings": [
    {
      "id": "places",
      "title": "Places",
      "detail": "Well-known places and your own, with distances and a map. Questions that are not about places are answered by the chat with its own tools.",
      "notice": {
        "when_empty": [
          "XEON_PLACES_EXTRA",
          "XEON_PLACES_FILES"
        ],
        "text": "Built-in places only: add your own in Own places or in Files."
      },
      "fields": [
        {
          "key": "XEON_PLACES_ENABLED",
          "kind": "toggle",
          "default": "1",
          "title": "Places on",
          "help": "Starts the places server with the engine; switched off, the agent answers without it."
        },
        {
          "key": "XEON_PLACES_UNITS",
          "kind": "choice",
          "default": "km",
          "options": [
            {
              "value": "km",
              "title": "Kilometres"
            },
            {
              "value": "mi",
              "title": "Miles"
            }
          ],
          "title": "Unit",
          "help": "Unit of distances and radii."
        },
        {
          "key": "XEON_PLACES_CATEGORIES",
          "kind": "choices",
          "default": "capital,mountain,landmark,custom",
          "options": [
            {
              "value": "capital",
              "title": "Capitals"
            },
            {
              "value": "mountain",
              "title": "Mountains"
            },
            {
              "value": "landmark",
              "title": "Landmarks"
            },
            {
              "value": "custom",
              "title": "My own"
            }
          ],
          "title": "Categories",
          "help": "Which places the agent knows."
        },
        {
          "key": "XEON_PLACES_HOME",
          "kind": "text",
          "placeholder": "Madrid",
          "title": "Home place",
          "help": "Where distances are measured from when the question does not say."
        },
        {
          "key": "XEON_PLACES_EXTRA",
          "kind": "json",
          "placeholder": "{\"Office\": [40.4531, -3.6883]}",
          "title": "Own places",
          "help": "JSON object of names to [latitude, longitude], or to {\"latitude\", \"longitude\", \"country\"}."
        },
        {
          "key": "XEON_PLACES_FILES",
          "kind": "paths",
          "file_types": [
            "geojson",
            "json",
            "csv"
          ],
          "folder_types": [
            "*"
          ],
          "title": "Files",
          "help": "Point GeoJSON or CSV with name, latitude and longitude columns, or folders holding them."
        },
        {
          "key": "XEON_PLACES_SERVICE_KEY",
          "kind": "secret",
          "title": "Service key",
          "help": "Kept in the Keychain. The example only says whether it is set; a real extension would send it to its service."
        }
      ]
    }
  ]
}
