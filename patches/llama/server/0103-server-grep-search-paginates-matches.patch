# 0103: grep_search reads past its first hundred matches
#
# Upstream 6054381 (row 10). The tool stopped at 100 matches with no way to ask for the next
# page, and its file order was whatever the directory walk produced, so an offset would not
# have been stable. It now takes offset/limit (max 100), sorts files by relative path, and
# reports how to fetch the next page, including when the file listing itself was cut short.
#
# Applies to XeonLLM's tools/server/server-tools.cpp; no server setting changes, agent output
# format only.
diff --git a/tools/server/server-tools.cpp b/tools/server/server-tools.cpp
index 45431a148..daa602c49 100644
--- a/tools/server/server-tools.cpp
+++ b/tools/server/server-tools.cpp
@@ -1108,7 +1108,8 @@ struct server_tool_grep_search : server_tool {
                     "Automatically skips files ignored by .gitignore (when the directory is inside a git repo) "
                     "and common junk directories (.git, node_modules, build, dist, etc.) otherwise. "
                     "include/exclude: a pattern with no '/' matches the basename at any depth; a pattern "
-                    "containing '/' matches the full relative path (auto-anchored with \"**/\" unless already anchored)."},
+                    "containing '/' matches the full relative path (auto-anchored with \"**/\" unless already anchored). "
+                    "Returns at most 100 matches per call; when more remain, the result gives the offset that reads the next ones."},
                 {"parameters", {
                     {"type", "object"},
                     {"properties", {
@@ -1120,6 +1121,8 @@ struct server_tool_grep_search : server_tool {
                         {"literal",             {{"type", "boolean"}, {"description", "Treat pattern as a literal string instead of a regular expression (default: false)"}}},
                         {"ignore_case",         {{"type", "boolean"}, {"description", "Case-insensitive search (default: false)"}}},
                         {"context_lines",       {{"type", "integer"}, {"description", "Number of lines of context to show before and after each match (default: 0)"}}},
+                        {"offset",              {{"type", "integer"}, {"description", "Number of matches to skip, to read past an earlier call (default: 0)"}}},
+                        {"limit",               {{"type", "integer"}, {"description", "Maximum number of matches to return (default and maximum: 100)"}}},
                     }},
                     {"required", json::array({"path", "pattern"})},
                 }},
@@ -1136,6 +1139,9 @@ struct server_tool_grep_search : server_tool {
         bool        literal     = json_value(params, "literal", false);
         bool        ignore_case = json_value(params, "ignore_case", false);
         int         ctx_lines   = std::max(0, json_value(params, "context_lines", 0));
+        size_t      offset      = (size_t) std::max(0, json_value(params, "offset", 0));
+        size_t      limit       = (size_t) std::clamp(json_value(params, "limit", (int) SERVER_TOOL_GREP_SEARCH_MAX_RESULTS),
+                                                      1, (int) SERVER_TOOL_GREP_SEARCH_MAX_RESULTS);
 
         std::string pattern_src = pat_str;
         if (literal) {
@@ -1162,6 +1168,7 @@ struct server_tool_grep_search : server_tool {
 
         // collect (absolute_path, display_path) pairs to search
         std::vector<std::pair<std::string, std::string>> files;
+        bool listing_truncated = false;
 
         const std::string abs_path = io->resolve(path);
         if (io->is_regular_file(abs_path)) {
@@ -1171,22 +1178,26 @@ struct server_tool_grep_search : server_tool {
             if (!listing.err.empty()) {
                 return {{"error", listing.err + ": " + path}};
             }
+            listing_truncated = listing.truncated;
             for (const auto & entry : listing.entries) {
                 if (!path_glob_match(include, entry.rel)) continue;
                 if (!exclude.empty() && path_glob_match(exclude, entry.rel)) continue;
                 files.emplace_back(path_to_utf8(path_from_utf8(abs_path) / path_from_utf8(entry.rel)), entry.rel);
             }
+            // a fixed order, so that an offset names the same matches on the next call
+            std::sort(files.begin(), files.end(), [](const auto & a, const auto & b) { return a.second < b.second; });
         } else {
             return {{"error", "path does not exist: " + path}};
         }
 
         std::ostringstream output_text;
+        size_t skipped = 0;
         size_t total = 0;
-        bool limit_reached = false;
+        bool more = false;
         bool show_num = show_lineno || ctx_lines > 0;
 
         for (const auto & file_entry : files) {
-            if (limit_reached) break;
+            if (more) break;
             const std::string & fpath        = file_entry.first;
             const std::string & display_path = file_entry.second;
 
@@ -1200,11 +1211,15 @@ struct server_tool_grep_search : server_tool {
             }
 
             for (size_t i = 0; i < lines.size(); i++) {
-                if (total >= SERVER_TOOL_GREP_SEARCH_MAX_RESULTS) {
-                    limit_reached = true;
+                if (!std::regex_search(lines[i], pattern)) continue;
+                if (skipped < offset) {
+                    skipped++;
+                    continue;
+                }
+                if (total >= limit) {
+                    more = true;
                     break;
                 }
-                if (!std::regex_search(lines[i], pattern)) continue;
 
                 long ctx_start = ctx_lines > 0 ? std::max<long>(0, (long) i - ctx_lines) : (long) i;
                 long ctx_end   = ctx_lines > 0 ? std::min<long>((long) lines.size() - 1, (long) i + ctx_lines) : (long) i;
@@ -1225,10 +1240,15 @@ struct server_tool_grep_search : server_tool {
         }
 
         output_text << "\n---\nTotal matches: " << total << "\n";
-        if (limit_reached) {
+        if (offset > 0) {
+            output_text << string_format("[These are the matches after the first %zu.]\n", offset);
+        }
+        if (more) {
             output_text << string_format(
-                "[%zu matches limit reached. Narrow the path/pattern/include to see more.]\n",
-                SERVER_TOOL_GREP_SEARCH_MAX_RESULTS);
+                "[More matches remain: call again with offset=%zu and the same other arguments.]\n", offset + total);
+        }
+        if (listing_truncated) {
+            output_text << "[The file listing was cut short, so some files were not searched.]\n";
         }
 
         return {{"plain_text_response", output_text.str()}};
