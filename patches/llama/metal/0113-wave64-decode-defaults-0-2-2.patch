                                          XEON_ENV("XEON_MV_Q4K_R4_DISABLE") == nullptr;
                 const bool q4k_small = ne00 <= 2048 || ne01 <= 2048 || q4k_r4_wide;
 
-                // XEON_MV_Q4K_V3 selects one of four off-by-default kernels. Value 1 is the
