-                // block and 8-byte quant loads to shorten the tail pass at k=2560. This hook
-                // runs before V2, so every V3 value wins when both switches are set. nr0 is
-                // returned here and carried by the kernel name, never overridden afterwards.
+                // XEON_MV_Q4K_V3 selects one of four kernels. Default (unset) is 2. Value 1 is
+                // the original broadcast-header kernel; 2/3 drop the shuffle; 4 uses 16 lanes per
+                // block and 8-byte quant loads to shorten the tail pass at k=2560. "0" is the
+                // pre-0.2.2 off path; any other value falls back to 2. This hook runs before V2,
+                // so every V3 value wins when both switches are set. nr0 is returned here and
+                // carried by the kernel name, never overridden afterwards.
                 static const int q4k_v3 = []() -> int {
                     const char * v = XEON_ENV("XEON_MV_Q4K_V3");
-                    return v != nullptr && v[0] >= '1' && v[0] <= '4' && v[1] == '\0' ? v[0] - '0' : 0;
+                    if (v == nullptr) return 2;
+                    if (v[0] == '0' && v[1] == '\0') return 0;
+                    return v[0] >= '1' && v[0] <= '4' && v[1] == '\0' ? v[0] - '0' : 2;
                 }();
                 if (q4k_v3 && simd_width == 64 &&
                     ggml_metal_device_get_props(ggml_metal_library_get_device(lib))->wave64_decode &&
