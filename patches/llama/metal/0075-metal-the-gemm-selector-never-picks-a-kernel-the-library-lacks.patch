+bool ggml_metal_library_has_function(ggml_metal_library_t lib, const char * name) {
+    @autoreleasepool {
+        NSString * fname = [NSString stringWithUTF8String:name];
+
+        [lib->lock lock];
+
+        bool found = lib->override_fns && [lib->override_fns containsObject:fname];
+        if (!found && lib->fn_to_lib) {
+            found = lib->fn_to_lib[fname] != nil;
+        }
+        if (!found && !lib->fn_to_lib && lib->objs[0]) {
+            // from-source and precompiled single-library builds carry no routing table; the
+            // selectors ask on every matmul, so the name list is read once and kept
+            if (!lib->fn_names) {
+                lib->fn_names = [[NSSet alloc] initWithArray:[lib->objs[0] functionNames]];
+            }
+            found = [lib->fn_names containsObject:fname];
+        }
+
+        [lib->lock unlock];
+
+        return found;
+    }
+}
+
 struct ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline(ggml_metal_library_t lib, const char * name) {
