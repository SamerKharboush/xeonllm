+//
+// kernel coverage
+//
+
+static void ggml_metal_check_fill(ggml_tensor * t, ggml_type type, int64_t ne0, int64_t ne1, int64_t ne2) {
+    memset(t, 0, sizeof(*t));
+    t->type  = type;
+    t->ne[0] = ne0;
+    t->ne[1] = ne1;
+    t->ne[2] = ne2;
+    t->ne[3] = 1;
+    t->nb[0] = ggml_type_size(type);
+    for (int i = 1; i < GGML_MAX_DIMS; ++i) {
+        t->nb[i] = t->nb[i-1]*(t->ne[i-1] > 0 ? t->ne[i-1] : 1);
+    }
+}
+
+void ggml_metal_library_check_kernels(ggml_metal_library_t lib) {
+    if (TOSH_ENV("TOSH_METAL_CHECK_KERNELS") == nullptr) {
+        return;
+    }
+
+    // below and above every row floor (2048, 4096) and the dense token floors (192, 256, 448)
+    static const int64_t rows[] = { 512, 1024, 2047, 2048, 2049, 4095, 4096, 8192 };
+    static const int64_t toks[] = { 1, 2, 8, 9, 32, 33, 191, 192, 255, 256, 447, 448, 1023, 1024, 2048 };
+    const int64_t k = 2560;
+
+    g_metal_check_kernels = true;
+    g_metal_check_missing.clear();
+
+    for (int t = 0; t < GGML_TYPE_COUNT; ++t) {
+        const ggml_type type = (ggml_type) t;
+        if (ggml_type_size(type) == 0) {
+            continue;
+        }
+
+        char plain[256];
+        snprintf(plain, 256, "kernel_mul_mm_%s_f32", ggml_metal_tname_pair(lib, type, GGML_TYPE_F32));
+        if (ggml_metal_library_has_function(lib, plain)) {
+            for (int64_t m : rows) {
+                for (int64_t n : toks) {
+                    ggml_tensor a = {};
+                    ggml_tensor b = {};
+                    ggml_tensor out = {};
+                    ggml_metal_check_fill(&a,   type,              k, m, 1);
+                    ggml_metal_check_fill(&b,   GGML_TYPE_F32,     k, n, 1);
+                    ggml_metal_check_fill(&out, GGML_TYPE_F32,     m, n, 1);
+                    out.op     = GGML_OP_MUL_MAT;
+                    out.src[0] = &a;
+                    out.src[1] = &b;
+                    ggml_metal_library_get_pipeline_mul_mm(lib, &out);
+                }
+            }
+        }
+
+        snprintf(plain, 256, "kernel_mul_mm_id_%s_f32", ggml_metal_tname_pair(lib, type, GGML_TYPE_F32));
+        if (ggml_metal_library_has_function(lib, plain)) {
+            const int64_t n_expert = 8;
+            for (int64_t m : rows) {
+                for (int64_t n : toks) {
+                    ggml_tensor as = {};
+                    ggml_tensor b  = {};
+                    ggml_tensor ids = {};
+                    ggml_tensor out = {};
+                    ggml_metal_check_fill(&as,  type,          k, m, n_expert);
+                    ggml_metal_check_fill(&b,   GGML_TYPE_F32, k, n, 1);
+                    ggml_metal_check_fill(&ids, GGML_TYPE_I32, n_expert, n, 1);
+                    ggml_metal_check_fill(&out, GGML_TYPE_F32, m, n, 1);
+                    out.op     = GGML_OP_MUL_MAT_ID;
+                    out.src[0] = &as;
+                    out.src[1] = &b;
+                    out.src[2] = &ids;
+                    ggml_metal_library_get_pipeline_mul_mm_id(lib, &out);
+                }
+            }
+        }
+    }
+
+    g_metal_check_kernels = false;
+
+    std::sort(g_metal_check_missing.begin(), g_metal_check_missing.end());
+    g_metal_check_missing.erase(std::unique(g_metal_check_missing.begin(), g_metal_check_missing.end()),
+                                g_metal_check_missing.end());
+
+    if (g_metal_check_missing.empty()) {
+        GGML_LOG_INFO("%s: every composed MUL_MAT and MUL_MAT_ID kernel is in the library\n", __func__);
+        return;
+    }
+
+    for (const std::string & name : g_metal_check_missing) {
+        GGML_LOG_ERROR("%s: kernel missing: %s\n", __func__, name.c_str());
+    }
+    GGML_LOG_ERROR("%s: %zu composed kernel names are not in the library\n", __func__,
+                   g_metal_check_missing.size());
+
+    exit(1);
+}
