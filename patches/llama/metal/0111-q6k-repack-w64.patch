+// Mark a Metal buffer as holding canonical bytes. Used by Dynamic MoE arenas, whose writers
+// bypass ggml_backend_tensor_set and therefore cannot be byte-permuted.
+GGML_BACKEND_API void ggml_backend_metal_mark_canonical(struct ggml_backend_buffer * buffer);
