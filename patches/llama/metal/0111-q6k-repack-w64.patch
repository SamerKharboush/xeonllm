+    // Q6_K byte-permuted tensors in this buffer, keyed by tensor offset
+    struct ggml_metal_q6k_rec * q6k_recs;
+    size_t q6k_nrecs;
+    size_t q6k_crecs;
+    bool q6k_canonical;
 };
 
 static void ggml_metal_log_allocated_size(id<MTLDevice> device, size_t size_aligned) {
@@ -3592,6 +3638,7 @@
 #endif
     }
 
+    free(buf->q6k_recs);
     free(buf);
 }
 
@@ -3601,12 +3648,173 @@
 
 bool ggml_metal_buffer_is_shared(ggml_metal_buffer_t buf) {
     return buf->is_shared;
+}
+
+bool ggml_metal_repack_enabled(void) {
+    return atomic_load(&g_xq6k_repack);
+}
+
+static bool ggml_metal_q6k_buffer_of(const struct ggml_tensor * t, ggml_metal_buffer_t * buf) {
+    struct ggml_backend_buffer * b = t->view_src ? t->view_src->buffer : t->buffer;
+    if (b == NULL || !ggml_backend_metal_buffer_is_metal(b)) {
+        return false;
+    }
+    *buf = (ggml_metal_buffer_t) b->context;
+    return *buf != NULL;
+}
+
+static bool ggml_metal_q6k_offset(ggml_metal_buffer_t buf, const struct ggml_tensor * t, size_t * offs) {
+    const char * data = (const char *) t->data;
+    for (int i = 0; i < buf->n_buffers; ++i) {
+        const char * base = (const char *) buf->buffers[i].data;
+        if (data >= base && data + ggml_nbytes(t) <= base + buf->buffers[i].size) {
+            *offs = (size_t)(data - base);
+            return true;
+        }
+    }
+    return false;
+}
+
+static struct ggml_metal_q6k_rec * ggml_metal_q6k_find(ggml_metal_buffer_t buf, size_t offs, size_t size) {
+    for (size_t i = 0; i < buf->q6k_nrecs; ++i) {
+        struct ggml_metal_q6k_rec * r = &buf->q6k_recs[i];
+        if (offs >= r->offs && offs + size <= r->offs + r->size) {
+            return r;
+        }
+    }
+    return NULL;
+}
+
+static void ggml_metal_q6k_add(ggml_metal_buffer_t buf, size_t offs, size_t size, size_t row, int nb) {
+    if (ggml_metal_q6k_find(buf, offs, size) != NULL) {
+        return;
+    }
+    if (buf->q6k_nrecs == buf->q6k_crecs) {
+        size_t cap = buf->q6k_crecs ? buf->q6k_crecs*2 : 16;
+        struct ggml_metal_q6k_rec * recs = (struct ggml_metal_q6k_rec *) realloc(buf->q6k_recs, cap*sizeof(*recs));
+        if (recs == NULL) {
+            return;
+        }
+        buf->q6k_recs = recs;
+        buf->q6k_crecs = cap;
+    }
+    struct ggml_metal_q6k_rec * r = &buf->q6k_recs[buf->q6k_nrecs++];
+    r->offs = offs;
+    r->size = size;
+    r->row  = row;
+    r->nb   = nb;
+}
+
+// Mark decision, made on the first write at offset 0 from the tensor's own eligibility. The
+// set_tensor offset (not the buffer offset) must be 0; size may be a loader chunk (< nbytes).
+static bool ggml_metal_q6k_eligible(ggml_metal_buffer_t buf, const struct ggml_tensor * t, size_t set_off) {
+    return atomic_load(&g_xq6k_repack) &&
+           t->type == GGML_TYPE_Q6_K &&
+           t->ne[2] == 1 && t->ne[3] == 1 &&
+           t->ne[0] % 2048 == 0 && t->nb[1] % 16 == 0 &&
+           set_off == 0 &&
+           !buf->is_shared && !buf->q6k_canonical &&
+           (t->buffer->usage & GGML_BACKEND_BUFFER_USAGE_WEIGHTS) != 0;
+}
+
+bool ggml_metal_repack_candidate(const struct ggml_tensor * t) {
