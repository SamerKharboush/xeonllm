+                const char * q6k_repack = XEON_ENV("XEON_Q6K_REPACK");
+                atomic_store(&g_xq6k_repack, dev->props.simd_width == 64 && q6k_repack != NULL && strcmp(q6k_repack, "1") == 0);
+
                 dev->props.has_simdgroup_mm = [dev->mtl_device supportsFamily:MTLGPUFamilyApple7];
 
                 // Manual tiled mul_mm replaces the missing simdgroup-matrix path on AMD.
@@ -2608,6 +2617,30 @@
     const bool use_mm_manual           = dev->props.use_mm_manual;
     const bool wave64_decode           = dev->props.wave64_decode;
     const bool has_bfloat              = dev->props.has_bfloat;
+
+    // repacked Q6_K bytes are valid only for the twins below; a view that cuts a row in half
+    // has no valid row-base mapping and every other reader goes to the CPU through get_tensor
+    if (ggml_metal_repack_is_rejected(op->src[0]) ||
+        ggml_metal_repack_is_rejected(op->src[1]) ||
+        ggml_metal_repack_is_rejected(op->src[2])) {
+        return false;
+    }
+    if (ggml_metal_repack_enabled()) {
+        for (size_t i = 0; i < 3; ++i) {
+            if (op->src[i] != NULL && ggml_metal_repack_is_tensor(op->src[i]) &&
+                op->op != GGML_OP_MUL_MAT && op->op != GGML_OP_GET_ROWS) {
+                return false;
+            }
+        }
+        // repacked Q6_K MUL_MAT is valid only for the w64 manual twin; any other path would
+        // read the canonical bytes as if they were still block-contiguous
+        if (op->op == GGML_OP_MUL_MAT && op->src[0] != NULL &&
+            ggml_metal_repack_is_tensor(op->src[0]) &&
