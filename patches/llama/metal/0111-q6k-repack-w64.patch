# 0111: off-by-default Q6_K row-base repack for wave64 (XEON_Q6K_REPACK=1)
#
# What. On a 64-lane (SIMD-width-64) Metal device, 2D Q6_K weights in a private, WEIGHTS-usage
# buffer whose row count stride nb01 % 16 == 0 (ne00 % 2048 == 0) are stored, on-card only, in a
# row-base "repacked" layout. The upload path permutes the incoming bytes; every consumer that
# reads the quantized bytes was given a twin kernel reading the repacked layout, or is routed
# off the Metal backend. The host-visible canonical bytes are reproduced exactly on readback;
# tensor bytes on disk, nb01/nb1 and ggml_nbytes are unchanged. No on-card copy is added.
#
# Why. Q6_K spreads ql/qh/scales/d across a 210-byte block, so a wave reads four scattered
# 16-128 B pieces per block per row. Grouping each field once per row puts every 16-byte quant
# load on a natural 16 B boundary and keeps whole fields contiguous, shortening the memory
# pipeline for the decode (mul_mv n=1), n=2..8 (mul_mv_ext) and prefill (mul_mm) kernels.
#
# On-card layout. Per row, nb = ne00/256 Q6_K blocks, row length nb*210 B:
#   canonical block-major:  for b in nb: [ ql 128 B | qh 64 B | scales 16 B | d 2 B ]
#   repacked field-major:   [ ql: nb*128 ][ qh: nb*64 ][ scales: nb*16 ][ d: nb*2 ]
# Total bytes and row stride are identical. Within a field the original order is preserved.
# Rows are independent. 16 B alignment of every 16 B load holds iff nb % 8 == 0 (nb >= 8,
# i.e. ne00 >= 2048), which the eligibility test enforces. Alignment of d (2 B) holds; scales
# are byte-wise.
#
# Range rule (B3/B4/B5). ggml_metal_repack_permute works on whole rows with offsets RELATIVE to
# the span start (never absolute tensor offsets), so a partial range never overruns a scratch
# buffer. Every set/get on a repacked tensor is row-granular read-modify-write:
#   read  = read the whole rows covering [offset, offset+size), un-permute into a temp, copy out
#           the requested bytes (ggml_metal_repack_read_canon).
#   set   = read those rows, un-permute, overlay the new bytes, permute, write the rows back
#           (ggml_metal_repack_write_canon). Edges of a chunked upload read rows not yet written;
#           harmless because a later chunk overwrites them.
# The set_tensor offset argument (not the buffer offset) decides the mark and must be 0; the
# record stores the FULL ggml_nbytes(t) range and the row stride t->nb[1], so a later chunk at
# offset > 0 resolves to the tensor and is permuted at row granularity.
#
# Eligibility (all must hold; decided at the first write at offset 0, recorded per buffer):
#   XEON_Q6K_REPACK == "1" at device init, simd_width == 64 (decided once at init); else nothing
#   tensor type Q6_K; ne[2] == 1 && ne[3] == 1 (not MUL_MAT_ID expert tensors);
#   ne00 % 2048 == 0; nb01 % 16 == 0;
#   buffer private (not shared/unified), usage & GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
#   not a DMoE arena (see marker); set_tensor offset == 0;
#   per-tensor record keyed to the tensor offset in the buffer, so views that start on a
#   repacked row boundary (whole-row multiple of the recorded row stride) still resolve to the
#   tensor; any other view (non-whole-row) is rejected: ggml_metal_repack_is_rejected() ->
#   supports_op false.
#
# Consumer table (every consumer of Q6_K on-card bytes; canonical = untouched):
#   path                                                         file:line            handling
#   MUL_MAT w64 n=1 decode                                       ggml-metal-ops.cpp    twin kernel_mul_mv_q6_K_f32_rb_w64_v1/_v2/_v3
#                                                                                       (XEON_Q6K_REPACK_KERNEL=1..3, default 2; nr0 2/4/8)
#   MUL_MAT w64 n=2..8 (mul_mv_ext)                              ggml-metal-ops.cpp    twin kernel_mul_mv_ext_q6_K_f32_rb_w64_r1_{2,3,4,5,8}
#                                                                                       int row; r0ptg=1; r1ptg/nsg unchanged
#   MUL_MAT prefill n>=threshold (mul_mm)                        ggml-metal-ops.cpp    twin kernel_mul_mm_q6_K_{f32,f16}_rb_w64
#                                                                                       same tiling/threadgroup/smem as the default w64 tile;
#                                                                                       RB NLR=4, nsg=narrow?2:4; only dequantize differs
#   fused QKV (QVK q4_K + Q6_K v + q4_K k)                       ggml-metal-ops.cpp    twin kernel_mul_mv_qvk_q4_K_q6_K_rb_q4_K_f32
#                                                                                       V branch only; Q/K branches canonical
#   GET_ROWS                                                     ggml-metal-ops.cpp    twin kernel_get_rows_q6_K_rb
#   every other op reading a repacked tensor                     ggml-metal-device.m   supports_op false
#   MUL_MAT_ID (3D Q6_K experts)                                 (not eligible)        canonical; ne[2]/ne[3] != 1 rejects repack
#   DMoE arena (batched upload / memset / readback / cpy)        llama-xeon-dmoe.cpp   canonical via marker; never repacked
#   SET_ROWS / MOE / quantize / flash-attn / conv / etc.         ggml-metal-device.m   supports_op false when a src is repacked
#   cpy_tensor / blit / memcpy between tensors                   ggml-metal-device.m   host round trip through get/set at offset 0,
#                                                                                       whole nbytes; never byte-blit a repacked row
#   DMoE bank upload path (ggml_metal_dmoe_upload_* / bank)      ggml-metal-*.m        canonical; arena marked canonical
#
# Kernel names + selection hooks (line numbers refer to the file in this patch):
#   dequantize_q6_K_rb()                                        kernels/dequantize.h   row-base twin helper
#   kernel_mul_mv_q6_K_f32_rb_w64_v1/_v2/_v3                    kernels/mul_mv_w64.metal  nr0=2/4/8
#   kernel_mul_mv_ext_q6_K_f32_rb_w64_r1_{2,3,4,5,8}            kernels/mul_mv_w64.metal
#   kernel_mul_mm_q6_K_f32_rb_w64 / _f16_rb_w64                 kernels/mul_mm_w64.metal  +_w_ variants
#   kernel_mul_mv_q6_K_f32_rb                                   kernels/mul_mv.metal  (present; not selected on wave64)
#   kernel_mul_mv_qvk_q4_K_q6_K_rb_q4_K_f32                     kernels/mul_mv.metal
#   kernel_get_rows_q6_K_rb                                     kernels/quantize.metal
#   hook mul_mv:    ggml_metal_library_get_pipeline_mul_mv      ggml-metal-device.cpp  (runs before _r4/_r8 w64; needs n=1, 2D, w64)
#   hook mul_mv_ext:ggml_metal_library_get_pipeline_mul_mv_ext  ggml-metal-device.cpp  (runs before kquant_ext; r0ptg=1)
#   hook mul_mm:    ggml_metal_library_get_pipeline_mul_mm      ggml-metal-device.cpp  (use_mm_manual && !has_tensor w64; twin mirrors default
#                                                                                       nr0/nr1/nsg/sgw/smem/dispatch; use_mm_manual=false -> supports_op false)
#   hook get_rows:  ggml_metal_library_get_pipeline_get_rows_rb ggml-metal-device.cpp
#   hook qvk:       ggml_metal_fuse_qvk                         ggml-metal-ops.cpp
#   dispatch ext r0ptg:                                         ggml-metal-ops.cpp
#   gate:           ggml_metal_repack_enabled / _is_tensor / _is_rejected (single predicate;
#                                                                                       _is_tensor already checks the env flag)
#   init:           XEON_Q6K_REPACK read once in ggml_metal_device_init; simd_width==64 only
#   variant:        XEON_Q6K_REPACK_KERNEL=1..3 (default 2) read at pipeline build
#
# Arena marker. DMoE buffers cannot be byte-permuted because their writers bypass
# ggml_backend_tensor_set. ggml_backend_metal_mark_canonical(ggml_backend_buffer_t)
# (ggml-metal.h; ggml-metal.cpp) sets ggml_metal_buffer.q6k_canonical = true and clears the
# repack records; called from llama-xeon-dmoe.cpp immediately after
# ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS) and before any
# ggml_backend_buffer_alloc / ggml_backend_tensor_set / arena memset / batched write on the
# arena. Canonical buffers are never repacked. Not a name/shape heuristic.
# Arena exclusion applies before any arena alloc/write. If the marker cannot be set (non-Metal
# buffer, null buffer), nothing is repacked in that buffer.
#
# Upload/readback paths touched (every path that moves tensor bytes):
#   ggml_metal_buffer_set_tensor            ggml-metal-device.m   row-granular RMW permute into on-card layout
#   ggml_metal_buffer_set_tensor_2d         ggml-metal-device.m   GGML_ABORT on a repacked tensor (B6)
#   ggml_metal_buffer_memset_tensor         ggml-metal-device.m   GGML_ABORT on a repacked tensor (B6)
#   ggml_metal_buffer_get_tensor            ggml-metal-device.m   row-granular inverse permute (arbitrary range)
#   ggml_metal_buffer_cpy_tensor            ggml-metal-device.m   host round trip get/set at 0, nbytes; exact
#   ggml_metal_set_tensor_async             ggml-metal-context.m  routed to synchronous RMW set
#   ggml_metal_get_tensor_async             ggml-metal-context.m  routed to synchronous RMW get
#   ggml_metal_buffer_clear                 ggml-metal-device.m   whole-buffer memset (canonical tensors unaffected on readback)
#   DMoE uploader + bank upload             ggml-metal-device.m / ggml-metal-context.m  canonical; marker prevents repack
#
# Reduction order changed. The repacked kernels keep the Q6_K algebra bit-identical per lane
# (same masks/scales/d, same order of adds inside a 16-value slice) but change which lane sums
# which block (ib = ip + k*NG, NG=4 on wave64 vs shipped NG=2 wave32 / per-block lane split)
# and add partial sums in a different simd_sum tree order. Last-bit differences are possible;
# eval-mode tolerance decides. Unset or wave32: unchanged.
#
# Off by default; unset or any other value leaves the default path byte-for-byte unchanged. The
# hot path adds a single bool check (ggml_metal_repack_enabled()) when no tensor is repacked.
# Nothing on 0109/0110 kernels or selection is altered; no new switch affects wave32.
#
# CPU-only verification (no GPU program, no engine build, no test-backend-ops run):
#   .scratch/xeonllm-0-2/evidence/t07/q6k_repack_cpu_check.py
#   - permutation round trip on whole-row spans (1 and 3 rows): max abs err 0, ROUNDTRIP_OK
#   - each repacked kernel lane mapping replayed vs dequantize_row_q6_K: max abs err 0.000e+00
#   - wave64 lane coverage (ib = ip + 4k over 64 lanes) covers every (ib, il): LANE_COVERAGE_OK
#   - mm tiled twin (il0 in {0,1}, il += 2 mod 16, ib++ on wrap) covers every (ib, il):
#     MM_LANE_COVERAGE_OK; ext twin (il 0..15, ib=ip+4k, R1 rows share the block):
#     EXT_LANE_COVERAGE_OK; both replay the same dequantize_q6_K_rb, max abs err 0.000e+00
#   - DISPATCH replay: ext m=2051 n=2 and mm m=1027 n=512; every output row reads its own
#     src0 row exactly once: EXT_DISPATCH_REPLAY_OK, MM_DISPATCH_REPLAY_OK
#   - B3/B4 device model: ~1 MB random-size chunked upload at offset 0, partial get at a
#     non-row offset crossing rows, partial RMW set, whole byte-exact get: RMW_CHUNKED_OK
#   - xcrun -sdk macosx metal -c on every changed .metal; clang++/clang -fsyntax-only on every
#     changed C/C++/ObjC file (both from a clean series-applied tree); no GPU test run here.
#   - test-backend-ops cases added (minimal, reach repacked path when env set): Q6_K 2D
#     n=1 m=2051 k=4096; n=1 k=2048 m=2051 (m tail); n=2,n=8; prefill mul_mm n=32,n=512;
#     test_q6k_repack_rw: ~1 MB non-row-aligned chunked upload, non-row partial get crossing
#     rows, partial RMW set, byte-exact whole get, then mul_mat on the repacked weight;
#     3D Q6_K mul_mat_id (n_mats=8,k=2048) stays canonical and passes. use_weight_context()
#     defaults to false (upstream); test_mul_mat and test_get_rows override it to env set &&
#     Q6_K && 2D src0 and put src0 in ctx_weights, so the twins are actually reached (F1).
#     XEON_Q6K_REPACK_LOG=1 prints one 'q6k-repack: mark <name> ...' line per marked tensor.
#     NOT RUN here (no cmake build, no test-backend-ops); compile-checked only.
#
# Known blockers / unsure (honest):
#   * ggml_metal_buffer_set_tensor_2d and ggml_metal_buffer_memset_tensor GGML_ABORT on a
#     repacked tensor (B6). Nothing calls them on a repacked tensor today (set_tensor_2d is
#     used for non-Q6_K/activation uploads; memset is not applied to repacked weights, and DMoE
#     arenas are canonical-marked), so the abort is a guard, not a live path.
#   * no GPU correctness or perf numbers; reduction order changed (above).
#   * ext twin keeps r0ptg=1 (one src0 row per threadgroup, R1 src1 rows); a multi-row src0
#     form is not simple (per-row dequant registers) and is left as a known cost for n=2..8.
#
# Round-4 root causes (card-1 rb3):
#   * ext: mul_mv_w64.metal:8772 used `const short row = tgpig.x`; wrong from output row 128 on.
#     The implementer attributes it to an AMD miscompile of the short index; not proven (2051
#     fits a short). `const int row` fixes it on card 1.
#   * mm: mul_mm_w64.metal:775-779 instantiated RB with NLR=8, but ggml-metal-device.cpp:1259-1262
#     dispatches the 64-lane 64x64/narrow shape and mul_mm_w64.metal:309-310 shows NLR8 expects a
#     different 128-column/B layout. Fixed RB to NLR=4 and nsg=narrow?2:4.
#
# Measured round 4 by orchestrator (engine v0.2.1-0111r4-avx1 = pin d81235049 + series through 0111 r4, AVX1 build,
#   card 1 only, GGML_METAL_DEVICE_INDEX=1; card 0 not run, needs the user's approval). Rounds 1-3 produced wrong
#   output (n=1 first_row*nb01 omitted, ext short row, mm NLR=8); their speed figures are void.
# - eval test-backend-ops: MUL_MAT 1844/1844 for off, KERNEL=1, KERNEL=2; GET_ROWS 232/232 every arm; "q6k-raw: OK"
#   in every repack arm, "SKIP (not repacked)" when off. KERNEL=3 1843/1844: MUL_MAT(m=1,n=1,k=2048) ERR 0.011.
#   Six repeats of m=1/2/64 per variant: KERNEL=2 and =3 each failed m=1 once (ERR 0.0012 / 0.0896), m=2/m=64 never.
#   Read as an ill-conditioned single-output NMSE on random data (test defect), not proven.
# - LFM3-1.7B Q6_K, llama-bench -ngl 99 -fa 1, default context, arms alternating, warmup discarded by llama-bench:
#   tg128 (-p 0 -n 128 -r 5, 6 rounds): off 32.79-32.82; K1 35.79-35.94; K2 37.15-37.38; K3 34.86-34.92 t/s
#   pp512 (-p 512 -n 0 -r 3, 3 rounds): off 203.5-204.1; K1 228.7-229.3; K2 228.8-229.6; K3 229.0-229.5 t/s
#   256-token greedy text via llama-server: 82d29582 in every arm, read (coherent); 71 marks per repack arm, 0 off.
# - perf us/run q6_K f32 (one process each), off / K1 / K2 / K3: m=248320 n=1 k=2048 7324 / 5402 / 3912 / 3977;
#   m=4096 n=1 k=14336 863 / 556 / 463 / 529; m=1024 n=1 k=2048 49.9 / 46.4 / 45.8 / 73.4;
#   m=4096 n=512 k=14336 114.1 ms / 84.3 / 84.2 / 84.3.
# - 35B (ornith-1.0-35b Q6_K dense + Q4_K experts), one-card Dynamic MoE (PLAN_FULL_HOST_DMOE), -c 16384 -fa auto
#   -ub 512 -b 512, llama-server, off vs K2 alternating, 3 rounds, each a fresh process (no warmup discard):
#   decode (128 tokens) off 16.00-16.03, K2 18.70-18.74 t/s; prompt (1141 tokens) off 82.7-84.3, K2 89.0-89.3 t/s.
#   271 tensors marked (attn/ssm/shared-expert/output), 0 routed-expert tensors. 128-token greedy text 252365df in
#   5 of 6 runs; the off arm's first run differed by two words (d959b6f1), a Dynamic MoE cold-placement near-tie
#   in the arm without the repack.
# - Default variant set to 2 after these measurements (unset == KERNEL=2, the measured path).

--- a/ggml/include/ggml-metal.h
+++ b/ggml/include/ggml-metal.h
@@ -56,6 +56,10 @@
 
