+struct ggml_metal_q6k_rec {
+    size_t offs;   // tensor byte offset inside the Metal buffer
+    size_t size;   // ggml_nbytes of the whole tensor
+    size_t row;    // row stride in bytes (t->nb[1]) the record was made with
+    int    nb;     // Q6_K blocks per row (ne00/256)
+};
