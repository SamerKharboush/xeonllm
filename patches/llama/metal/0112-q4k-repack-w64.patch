+// XEON_Q4K_REPACK decode: the 0110 value-2 shape (uint4 quant loads, 8 lanes per block), but
+// the quant bytes come from the field-major row layout. nr0=16 rows per simdgroup.
+template<short nr0, typename args_t>
+void kernel_mul_mv_q4_K_f32_rb_w64_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
