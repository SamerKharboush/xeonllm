+// Repack is per type: Q6_K under XEON_Q6K_REPACK, Q4_K under XEON_Q4K_REPACK. A type is
+// eligible only when its own flag is set, so the two repacks never interfere.
+static bool ggml_metal_repack_type_on(const struct ggml_tensor * t) {
+    if (t->type == GGML_TYPE_Q6_K) {
+        return atomic_load(&g_xq6k_repack);
+    }
+    if (t->type == GGML_TYPE_Q4_K) {
+        return atomic_load(&g_xq4k_repack);
+    }
+    return false;
+}
+
+// Shape gate. Q6_K rows are 210*nb bytes, 16 B aligned only when nb % 8 == 0 (ne00 % 2048).
+// Q4_K rows are 144*nb bytes and 144 = 9*16, so every row start is 16 B aligned for any nb.
+static bool ggml_metal_repack_shape_ok(const struct ggml_tensor * t) {
+    if (t->ne[2] != 1 || t->ne[3] != 1) {
+        return false;
+    }
+    if (t->type == GGML_TYPE_Q6_K) {
+        return t->ne[0] % 2048 == 0 && t->nb[1] % 16 == 0;
+    }
+    return t->type == GGML_TYPE_Q4_K;
+}
