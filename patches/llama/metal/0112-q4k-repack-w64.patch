+            const uint w1 = (uint) scb[4] | ((uint) scb[5] << 8) | ((uint) scb[6] << 16) | ((uint) scb[7] << 24);
+            const uint w2 = (uint) scb[8] | ((uint) scb[9] << 8) | ((uint) scb[10] << 16) | ((uint) scb[11] << 24);
+            const half hd   = *(device const half *) (r + 140*nb + ib*2);
+            const half hmin = *(device const half *) (r + 142*nb + ib*2);
