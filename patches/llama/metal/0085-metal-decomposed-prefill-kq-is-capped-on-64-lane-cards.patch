+// Decomposed prefill materialises an f32 KQ of [n_tokens(q), n_kv(k), n_head(q)] (after the permutes).
+// Only the 64-lane default is capped; the other conditions are checked by the caller.
+static bool decomposed_kq_bytes_ok(const ggml_tensor * q, const ggml_tensor * k) {
+    static const size_t cap = []() {
+        const char * e = getenv("XEON_FA_PF_DECOMP_MAX_MB");
+        const long long v = e ? atoll(e) : 0;
+        return v > 0 ? (size_t) v * 1024 * 1024 : (size_t) 256 * 1024 * 1024;
+    }();
+    return q->ne[1] * k->ne[1] * q->ne[2] * 4 <= (int64_t) cap;
+}
