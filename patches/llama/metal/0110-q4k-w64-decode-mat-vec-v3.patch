+// Off-by-default V3: eight lanes cover one block with a 16-byte quant load each, so the block's
+// qs array arrives as one contiguous 128-byte run. The 16-byte header is loaded by one lane and
+// broadcast; the row count is carried by the entry point name and the picker's nr0.
+template<short nr0, typename args_t>
+void kernel_mul_mv_q4_K_f32_v3_w64_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const short NG = FC_mul_mv_nw/8;
+    const short ix = tiisg/8;
+    const short it = tiisg%8;
+    const short p  = it/2;
+
+    const int nb = args.ne00/QK_K;
+
+    const int r0 = tgpig.x;
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+
+    const int first_row = (r0 * NSG + sgitg) * nr0;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = first_row*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+    const uint64_t offset1 =        r1*args.nb11 + (i12        )*args.nb12 + (i13        )*args.nb13;
+
+    device const block_q4_K * x = (device const block_q4_K *) (src0 + offset0);
+    device const float     * y = (device const float      *) (src1 + offset1);
+
+    float yl[16];
+    float yh[16];
+
+    float sumf[nr0]={0.f};
+
+    // qs bytes 16*it..16*it+15: low nibbles are y[64*p + 16*(it%2) + 0..15],
+    // high nibbles are y[64*p + 32 + 16*(it%2) + 0..15]
+    const int lo = 64*p + 16*(it%2);
+    device const float * yl4 = y + ix*QK_K + lo;
+    device const float * yh4 = y + ix*QK_K + lo + 32;
+
+    for (int ib = ix; ib < nb; ib += NG) {
+        float sy0 = 0.f, sy1 = 0.f;
+
+        FOR_UNROLL (short i = 0; i < 4; ++i) {
+            const float4 a = *(device const float4 *)(yl4 + 4*i);
+            yl[4*i+0] = a[0]; yl[4*i+1] = a[1]; yl[4*i+2] = a[2]; yl[4*i+3] = a[3];
+            sy0 += a[0] + a[1] + a[2] + a[3];
+
+            const float4 b = *(device const float4 *)(yh4 + 4*i);
+            yh[4*i+0] = b[0]; yh[4*i+1] = b[1]; yh[4*i+2] = b[2]; yh[4*i+3] = b[3];
+            sy1 += b[0] + b[1] + b[2] + b[3];
+        }
+
+        device const uint4 * hp = (device const uint4 *) &x[ib];
+        device const uint4 * q  = (device const uint4 *) (x[ib].qs + 16*(int) it);
+
+        for (short row = 0; row < nr0; ++row) {
+            if (first_row + row >= args.ne0) {
+                break;
+            }
+
+            // one load for the 8 lanes covering this block, then a register broadcast
+            uint4 hdr = it == 0 ? *hp : uint4(0);
+            const ushort src = 8*(int) ix;
+            hdr.x = simd_shuffle(hdr.x, src);
+            hdr.y = simd_shuffle(hdr.y, src);
+            hdr.z = simd_shuffle(hdr.z, src);
+            hdr.w = simd_shuffle(hdr.w, src);
+
+            const half2 dm = as_type<half2>(hdr.x);
+
+            // same unpack as the shipped Q4_K kernels, with p mod 2 selecting the word half
+            const ushort shs = 16*(p & 1);
+            const uint16_t s0 = (uint16_t) (hdr.y >> shs);
+            const uint16_t s2 = (uint16_t) (hdr.z >> shs);
+            const uint16_t s4 = (uint16_t) (hdr.w >> shs);
+
+            float sc0, sc1, mn0, mn1;
+            if (p < 2) {
+                sc0 = (float) (s0 & 63);
+                sc1 = (float) ((s0 >> 8) & 63);
+                mn0 = (float) (s2 & 63);
+                mn1 = (float) ((s2 >> 8) & 63);
+            } else {
+                sc0 = (float) ((s4 & 15) | ((s0 & 0xc0) >> 2));
+                sc1 = (float) (((s4 >> 8) & 15) | (((s0 >> 8) & 0xc0) >> 2));
+                mn0 = (float) (((s4 >> 4) & 15) | ((s2 & 0xc0) >> 2));
+                mn1 = (float) (((s4 >> 12) & 15) | (((s2 >> 8) & 0xc0) >> 2));
+            }
+
+            const uint4 qv = *q;
+            thread const uint16_t * qh = (thread const uint16_t *) &qv;
+
+            float4 acc1 = {0.f, 0.f, 0.f, 0.f};
+            float4 acc2 = {0.f, 0.f, 0.f, 0.f};
+
+            FOR_UNROLL (short i = 0; i < 4; ++i) {
+                // bytes 0..7 of the chunk: low nibbles use sc0, high nibbles use sc1
+                const uint16_t v1 = qh[i];
+                acc1[0] += yl[2*i+0] * (v1 & 0x000F);
+                acc1[1] += yl[2*i+1] * (v1 & 0x0F00);
+                acc1[2] += yh[2*i+0] * (v1 & 0x00F0);
+                acc1[3] += yh[2*i+1] * (v1 & 0xF000);
+
+                // bytes 8..15: same two scale pairs, next eight activations
+                const uint16_t v2 = qh[i+4];
+                acc2[0] += yl[2*i+8] * (v2 & 0x000F);
+                acc2[1] += yl[2*i+9] * (v2 & 0x0F00);
+                acc2[2] += yh[2*i+8] * (v2 & 0x00F0);
+                acc2[3] += yh[2*i+9] * (v2 & 0xF000);
+            }
+
+            const float dl = (acc1[0] + 1.f/256.f*acc1[1]) +
+                             (acc2[0] + 1.f/256.f*acc2[1]);
+            const float dh = (acc1[2] + 1.f/256.f*acc1[3] +
+                              acc2[2] + 1.f/256.f*acc2[3]) * 1.f/16.f;
+
+            sumf[row] += dm[0] * (dl*sc0 + dh*sc1) - dm[1] * (sy0*mn0 + sy1*mn1);
+
+            q  = (device const uint4 *) ((device const char *) q  + args.nb01);
+            hp = (device const uint4 *) ((device const char *) hp + args.nb01);
+        }
+
+        yl4 += NG * QK_K;
+        yh4 += NG * QK_K;
     }
 
     device float * dst_f32 = (device float *) dst + (int64_t)im*args.ne0*args.ne1 + (int64_t)r1*args.ne0;
@@ -890,6 +1035,252 @@
     }
 }
 
+// p indexes a 32-byte qs chunk. Its two scale/min pairs live in the same 16-bit words,
+// low pair in bits 0..5/8..13, high pair in bits 16..21/24..29.
+static inline float4 q4k_v3_scales(uint4 hdr, short p) {
+    const ushort shs = 16*(p & 1);
+    const uint16_t s0 = (uint16_t) (hdr.y >> shs);
+    const uint16_t s2 = (uint16_t) (hdr.z >> shs);
+    const uint16_t s4 = (uint16_t) (hdr.w >> shs);
+
+    if (p < 2) {
+        return {(float) (s0 & 63), (float) ((s0 >> 8) & 63),
+                (float) (s2 & 63), (float) ((s2 >> 8) & 63)};
+    }
+
+    return {(float) ((s4 & 15) | ((s0 & 0xc0) >> 2)),
+            (float) (((s4 >> 8) & 15) | (((s0 >> 8) & 0xc0) >> 2)),
+            (float) (((s4 >> 4) & 15) | ((s2 & 0xc0) >> 2)),
+            (float) (((s4 >> 12) & 15) | (((s2 >> 8) & 0xc0) >> 2))};
+}
+
+// XEON_MV_Q4K_V3=2/3: same 16-byte quant loads as V3, but every lane loads the 16-byte
+// header itself. Eight lanes hitting one address still form one cache line, and no
+// cross-lane broadcast is needed. nr0 is carried by the entry point name and the picker.
+template<short nr0, typename args_t>
+void kernel_mul_mv_q4_K_f32_v3ns_w64_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
+        ushort tiisg,
+        ushort sgitg) {
+    const short NSG = FC_mul_mv_nsg;
+
+    const short NG = FC_mul_mv_nw/8;
+    const short ix = tiisg/8;
+    const short it = tiisg%8;
+    const short p  = it/2;
+
+    const int nb = args.ne00/QK_K;
+
+    const int r0 = tgpig.x;
+    const int r1 = tgpig.y;
+    const int im = tgpig.z;
+
+    const int first_row = (r0 * NSG + sgitg) * nr0;
+
+    const uint i12 = im%FC_mul_mv_ne12;
+    const uint i13 = im/FC_mul_mv_ne12;
+
+    const uint64_t offset0 = first_row*args.nb01 + (i12/FC_mul_mv_r2)*args.nb02 + (i13/FC_mul_mv_r3)*args.nb03;
+    const uint64_t offset1 =        r1*args.nb11 + (i12        )*args.nb12 + (i13        )*args.nb13;
+
+    device const block_q4_K * x = (device const block_q4_K *) (src0 + offset0);
+    device const float     * y = (device const float      *) (src1 + offset1);
+
+    float yl[16];
+    float yh[16];
+
+    float sumf[nr0]={0.f};
+
+    // qs bytes 16*it..16*it+15: low nibbles are y[64*p + 16*(it%2) + 0..15],
+    // high nibbles are y[64*p + 32 + 16*(it%2) + 0..15]
+    const int lo = 64*p + 16*(it%2);
+    device const float * yl4 = y + ix*QK_K + lo;
+    device const float * yh4 = y + ix*QK_K + lo + 32;
+
+    for (int ib = ix; ib < nb; ib += NG) {
+        float sy0 = 0.f, sy1 = 0.f;
+
+        FOR_UNROLL (short i = 0; i < 4; ++i) {
+            const float4 a = *(device const float4 *)(yl4 + 4*i);
+            yl[4*i+0] = a[0]; yl[4*i+1] = a[1]; yl[4*i+2] = a[2]; yl[4*i+3] = a[3];
+            sy0 += a[0] + a[1] + a[2] + a[3];
+
+            const float4 b = *(device const float4 *)(yh4 + 4*i);
+            yh[4*i+0] = b[0]; yh[4*i+1] = b[1]; yh[4*i+2] = b[2]; yh[4*i+3] = b[3];
+            sy1 += b[0] + b[1] + b[2] + b[3];
+        }
+
+        device const uint4 * hp = (device const uint4 *) &x[ib];
+        device const uint4 * q  = (device const uint4 *) (x[ib].qs + 16*(int) it);
+
+        for (short row = 0; row < nr0; ++row) {
+            if (first_row + row >= args.ne0) {
+                break;
+            }
+
+            const uint4  hdr = *hp;
+            const half2  dm  = as_type<half2>(hdr.x);
+            const float4 sc  = q4k_v3_scales(hdr, p);
+
+            const uint4 qv = *q;
+            thread const uint16_t * qh = (thread const uint16_t *) &qv;
+
+            float4 acc1 = {0.f, 0.f, 0.f, 0.f};
+            float4 acc2 = {0.f, 0.f, 0.f, 0.f};
+
+            FOR_UNROLL (short i = 0; i < 4; ++i) {
+                const uint16_t v1 = qh[i];
+                acc1[0] += yl[2*i+0] * (v1 & 0x000F);
+                acc1[1] += yl[2*i+1] * (v1 & 0x0F00);
+                acc1[2] += yh[2*i+0] * (v1 & 0x00F0);
+                acc1[3] += yh[2*i+1] * (v1 & 0xF000);
+
+                const uint16_t v2 = qh[i+4];
+                acc2[0] += yl[2*i+8] * (v2 & 0x000F);
+                acc2[1] += yl[2*i+9] * (v2 & 0x0F00);
+                acc2[2] += yh[2*i+8] * (v2 & 0x00F0);
+                acc2[3] += yh[2*i+9] * (v2 & 0xF000);
+            }
+
+            const float dl = (acc1[0] + 1.f/256.f*acc1[1]) +
+                             (acc2[0] + 1.f/256.f*acc2[1]);
+            const float dh = (acc1[2] + 1.f/256.f*acc1[3] +
+                              acc2[2] + 1.f/256.f*acc2[3]) * 1.f/16.f;
+
+            sumf[row] += dm[0] * (dl*sc[0] + dh*sc[1]) - dm[1] * (sy0*sc[2] + sy1*sc[3]);
+
+            q  = (device const uint4 *) ((device const char *) q  + args.nb01);
+            hp = (device const uint4 *) ((device const char *) hp + args.nb01);
+        }
+
+        yl4 += NG * QK_K;
+        yh4 += NG * QK_K;
+    }
+
+    device float * dst_f32 = (device float *) dst + (int64_t)im*args.ne0*args.ne1 + (int64_t)r1*args.ne0;
+
+    for (int row = 0; row < nr0 && first_row + row < args.ne0; ++row) {
+        float sum_all = simd_sum(sumf[row]);
+        if (tiisg == 0) {
+            dst_f32[first_row + row] = sum_all;
+        }
+    }
+}
+
+// XEON_MV_Q4K_V3=4: sixteen lanes cover one block with an 8-byte quant load each, so the
+// 128-byte qs run still arrives in one pass but NG drops from 8 to 4 for short k. Each lane
+// handles eight low and eight high activations; simd_sum adds the partial sums.
+template<short nr0, typename args_t>
+void kernel_mul_mv_q4_K_f32_v3u2_w64_impl(
+        args_t args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem,
+        uint3  tgpig,
