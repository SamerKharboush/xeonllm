                                          XEON_ENV("XEON_MV_Q4K_R4_DISABLE") == nullptr;
                 const bool q4k_small = ne00 <= 2048 || ne01 <= 2048 || q4k_r4_wide;
+
+                // XEON_MV_Q4K_V3 selects one of four off-by-default kernels. Value 1 is the
+                // original broadcast-header kernel; 2/3 drop the shuffle; 4 uses 16 lanes per
+                // block and 8-byte quant loads to shorten the tail pass at k=2560. This hook
+                // runs before V2, so every V3 value wins when both switches are set. nr0 is
+                // returned here and carried by the kernel name, never overridden afterwards.
+                static const int q4k_v3 = []() -> int {
+                    const char * v = XEON_ENV("XEON_MV_Q4K_V3");
+                    return v != nullptr && v[0] >= '1' && v[0] <= '4' && v[1] == '\0' ? v[0] - '0' : 0;
+                }();
+                if (q4k_v3 && simd_width == 64 &&
+                    ggml_metal_device_get_props(ggml_metal_library_get_device(lib))->wave64_decode &&
+                    ne11 == 1 && ne12 == 1 && ne13 == 1 &&
+                    !q4k_small && ne01 >= 16 && ne01 % 16 == 0 &&
+                    ne00 % 256 == 0 && op->src[0]->nb[1] % 16 == 0 &&
+                    ((uintptr_t) op->src[0]->data % 16) == 0 &&
+                    op->src[1]->nb[1] % 16 == 0 && op->src[1]->nb[2] % 16 == 0 &&
+                    op->src[1]->nb[3] % 16 == 0 &&
+                    ((uintptr_t) op->src[1]->data % 16) == 0 &&
+                    XEON_ENV("XEON_MV_Q4K_W64_DISABLE") == nullptr) {
+                    nsg = 1;
+                    switch (q4k_v3) {
+                        case 1: nr0 = 16; suffix = "_L8r16_v3";     break;
+                        case 2: nr0 = 16; suffix = "_L8r16_v3ns";   break;
+                        case 3: nr0 =  8; suffix = "_L8r8_v3ns";    break;
+                        case 4: nr0 = 16; suffix = "_L16r16_v3u2";  break;
