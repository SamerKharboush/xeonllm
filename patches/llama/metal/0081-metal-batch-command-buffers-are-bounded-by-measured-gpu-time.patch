+// tosh: GPU time per command buffer of a batch graph. A prefill graph's cost grows with the
+// cached context (attention), and on 2026-11-07 a 14B layer split at -c 16384 ran its five
+// buffers for seconds each on the display card until macOS panicked (WindowServer watchdog).
+// The estimate is picoseconds of GPU time per (token x node); it follows a higher measurement at
+// once and decays slowly, so a context that keeps growing is never predicted cheaper than it was.
+struct tosh_cb_est {
+    _Atomic uint64_t ps_per_tn;
+    _Atomic int      floor_logged;
+};
+
+struct tosh_cb_graph {
+    struct tosh_cb_est * est;
+    int64_t n_tokens;
+    int     n_nodes;
+    int     n_bufs;
+    int     target_ms;
+    bool    stats;
+    char    name[64];
+    _Atomic int      n_left;
+    _Atomic uint64_t max_ns;
+    _Atomic uint64_t sum_ns;
+};
+
+static bool tosh_cb_stats_on(void) {
+    static int st = -1;
+    if (st < 0) {
+        const char * e = getenv("TOSH_MTL_CB_STATS");
+        st = (e != NULL && strcmp(e, "0") != 0) ? 1 : 0;
+    }
+    return st == 1;
+}
+
+static void tosh_cb_release(struct tosh_cb_graph * g) {
+    if (g == NULL || atomic_fetch_sub_explicit(&g->n_left, 1, memory_order_acq_rel) != 1) {
+        return;
+    }
+    const uint64_t sum = atomic_load_explicit(&g->sum_ns, memory_order_relaxed);
+    const uint64_t mx  = atomic_load_explicit(&g->max_ns, memory_order_relaxed);
+    const double   tn  = (double) g->n_tokens * (double) g->n_nodes;
+    if (sum > 0 && tn > 0) {
+        const uint64_t meas = (uint64_t) (1000.0*(double) sum/tn);
+        const uint64_t old  = atomic_load_explicit(&g->est->ps_per_tn, memory_order_relaxed);
+        const uint64_t dec  = old - old/16;
+        atomic_store_explicit(&g->est->ps_per_tn, meas > dec ? meas : dec, memory_order_relaxed);
+    }
+    if (g->stats) {
+        fprintf(stderr, "ggml_metal: %s cb stats: n_tokens=%lld n_nodes=%d n_cb=%d max=%.1f ms sum=%.1f ms\n",
+                g->name, (long long) g->n_tokens, g->n_nodes, g->n_bufs, mx/1e6, sum/1e6);
+    }
+    // one node per buffer is the finest cut: past it only a smaller ubatch helps
+    if (g->target_ms > 0 && g->n_nodes > 0 && sum/(uint64_t) g->n_nodes > (uint64_t) g->target_ms*1000000ull &&
+        atomic_exchange(&g->est->floor_logged, 1) == 0) {
+        GGML_LOG_WARN("ggml_metal: %s: one node of a %lld-token batch averages %.1f ms, over the %d ms command-buffer target; use a smaller ubatch\n",
+                g->name, (long long) g->n_tokens, (double) sum/g->n_nodes/1e6, g->target_ms);
+    }
+    free(g);
+}
+
+static void tosh_cb_attach(id<MTLCommandBuffer> cb, struct tosh_cb_graph * g) {
+    if (g == NULL) {
+        return;
+    }
+    atomic_fetch_add_explicit(&g->n_left, 1, memory_order_relaxed);
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> b) {
+        const double t0 = [b GPUStartTime];
+        const double t1 = [b GPUEndTime];
+        if (t1 > t0) {
+            const uint64_t d = (uint64_t)((t1 - t0)*1e9);
+            atomic_fetch_add_explicit(&g->sum_ns, d, memory_order_relaxed);
+            uint64_t m = atomic_load_explicit(&g->max_ns, memory_order_relaxed);
+            while (d > m) {
+                if (atomic_compare_exchange_weak(&g->max_ns, &m, d)) break;
+            }
+        }
+        tosh_cb_release(g);
+    }];
+}
