@@ -224,16 +226,57 @@ llama_context::llama_context(
         if (model.tok_embd == nullptr || model.output == nullptr) {
             if (params.ctx_other == nullptr) {
                 throw std::runtime_error(model.arch_name() + " requires ctx_other to be set (this warning is normal during memory fitting)");
             }
             cparams.ctx_other = params.ctx_other;
         }
     }
 
+    // xeon: a dflash draft on a card that borrows a host lm head gets one copy of it on its
+    // own device at load, so each draft's 4-column head product runs there (XEON_DFLASH_HEAD_HOST=1 keeps the host path).
+    // A head on another card (the expert tier's target, the draft on the idle card) is copied the same way: a
+    // private buffer of one card cannot be read by the other, and the scheduler aborts on it.
+    if (model.arch == LLM_ARCH_DFLASH && model.output == nullptr && cparams.ctx_other != nullptr) {
+        ggml_tensor * src = llama_get_model(cparams.ctx_other)->output;
+        ggml_tensor * w   = !model.layers.empty() && model.layers[0].attn_norm ? model.layers[0].attn_norm : model.output_norm;
+        const bool src_host  = src && src->buffer && ggml_backend_buffer_is_host(src->buffer);
+        const bool other_dev = src && src->buffer && !src_host && w && w->buffer &&
+            ggml_backend_buffer_get_type(src->buffer) != ggml_backend_buffer_get_type(w->buffer);
+        if ((src_host || other_dev) && w && w->buffer &&
+            !ggml_backend_buft_is_host(ggml_backend_buffer_get_type(w->buffer))) {
+            ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(w->buffer);
+            const double mib = ggml_nbytes(src)/1048576.0;
+            if (src_host && getenv("XEON_DFLASH_HEAD_HOST")) {
+                LLAMA_LOG_INFO("%s: dflash lm head kept on the host (XEON_DFLASH_HEAD_HOST, %.1f MiB)\n", __func__, mib);
+            } else {
+                ggml_init_params ip = { ggml_tensor_overhead(), nullptr, true };
+                ctx_head_dev.reset(ggml_init(ip));
+                ggml_tensor * dst = ggml_dup_tensor(ctx_head_dev.get(), src);
+                ggml_set_name(dst, "output_other_dev");
+                buf_head_dev.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx_head_dev.get(), buft));
+                if (!buf_head_dev) {
+                    LLAMA_LOG_WARN("%s: no room on %s for the %.1f MiB dflash lm head, keeping it on the host\n",
+                            __func__, ggml_backend_buft_name(buft), mib);
+                    ctx_head_dev.reset();
+                } else {
+                    ggml_backend_buffer_set_usage(buf_head_dev.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+                    if (src_host) {
+                        ggml_backend_tensor_set(dst, src->data, 0, ggml_nbytes(src));
+                    } else {
+                        ggml_backend_tensor_copy(src, dst);
+                    }
+                    cparams.output_other_dev = dst;
+                    LLAMA_LOG_INFO("%s: dflash lm head copied from %s to %s (%.1f MiB, %s)\n", __func__,
+                            ggml_backend_buffer_name(src->buffer), ggml_backend_buft_name(buft), mib, ggml_type_name(src->type));
+                }
+            }
+        }
+    }
+
     if (cparams.rope_scaling_type == LLAMA_ROPE_SCALING_TYPE_UNSPECIFIED) {
