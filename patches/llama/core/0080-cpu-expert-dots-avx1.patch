+++ b/tests/test-vec-dot-multi.cpp
@@ -0,0 +1,105 @@
+// Checks that the multi-row dot kernels match the single-row dot bit for bit.
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static uint32_t rng_state = 12345;
+
+static float next_float(void) {
+    rng_state = rng_state*1664525u + 1013904223u;
+    return ((float) (rng_state >> 8)/(float) 0x00ffffffu)*2.0f - 1.0f;
+}
+
+static int run_type(const struct ggml_type_traits_cpu * cpu, ggml_cpu_vec_dot_multi_t multi,
+                    enum ggml_type type, const char * name, int n) {
+    const size_t w_size = ggml_row_size(type, n);
+    const size_t a_size = ggml_row_size(cpu->vec_dot_type, n);
+
+    std::vector<float> w(n);
+    std::vector<float> a(n);
+    std::vector<char> wq(w_size);
+
+    for (int i = 0; i < n; ++i) {
+        w[i] = next_float();
+    }
+    ggml_get_type_traits_cpu(type)->from_float(w.data(), wq.data(), n);
+
+    std::vector<std::vector<char>> rows(4);
+    for (int r = 0; r < 4; ++r) {
+        rows[r].resize(a_size);
+        for (int i = 0; i < n; ++i) {
+            a[i] = next_float();
+        }
+        ggml_get_type_traits_cpu(cpu->vec_dot_type)->from_float(a.data(), rows[r].data(), n);
+    }
+
+    int ret = 0;
+    for (int nc = 1; nc <= 4; ++nc) {
+        const void * vy[4];
+        for (int r = 0; r < nc; ++r) {
+            vy[r] = rows[r].data();
+        }
+        float got[4] = { 0, 0, 0, 0 };
+        multi(n, nc, got, wq.data(), vy);
+
+        bool ok = true;
+        for (int r = 0; r < nc; ++r) {
+            float ref = 0;
+            cpu->vec_dot(n, &ref, 0, wq.data(), 0, rows[r].data(), 0, 1);
+            if (memcmp(&got[r], &ref, sizeof(float)) != 0) {
+                printf("%s n=%d nc=%d DIFF row=%d multi=%.9g single=%.9g\n", name, n, nc, r, got[r], ref);
+                ret = 1;
+                ok = false;
+                break;
+            }
+        }
+        if (ok) {
+            printf("%s n=%d nc=%d identical\n", name, n, nc);
+        }
+    }
+    return ret;
+}
+
+int main(void) {
+    // only the test TU flags; the ggml-cpu objects carry the backend arch flags
+#ifdef __AVX2__
+    printf("test TU: __AVX2__ defined\n");
+#else
+    printf("test TU: __AVX2__ not defined\n");
+#endif
+#ifdef __AVX__
+    printf("test TU: __AVX__ defined\n");
+#else
+    printf("test TU: __AVX__ not defined\n");
+#endif
+#ifdef __FMA__
+    printf("test TU: __FMA__ defined\n");
+#else
+    printf("test TU: __FMA__ not defined\n");
+#endif
+
+    const enum ggml_type types[] = { GGML_TYPE_Q6_K, GGML_TYPE_Q4_K, GGML_TYPE_Q8_0 };
+    const char * names[]        = { "q6_K",         "q4_K",         "q8_0"         };
+    const int sizes[]           = { 256, 4096, 5120 };
+
+    int ret = 0;
+    for (size_t t = 0; t < sizeof(types)/sizeof(types[0]); ++t) {
+        const struct ggml_type_traits_cpu * cpu = ggml_get_type_traits_cpu(types[t]);
+        const ggml_cpu_vec_dot_multi_t multi = ggml_cpu_get_vec_dot_multi(types[t]);
+        if (multi == NULL) {
+            printf("%s getter NULL\n", names[t]);
+            ret = 1;
+            continue;
+        }
+        for (size_t s = 0; s < sizeof(sizes)/sizeof(sizes[0]); ++s) {
+            ret |= run_type(cpu, multi, types[t], names[t], sizes[s]);
+        }
+    }
+
+    return ret;
+}
