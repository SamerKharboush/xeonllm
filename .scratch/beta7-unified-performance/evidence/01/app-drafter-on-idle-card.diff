+        XCTAssertNotEqual(cards.expert, cards.drafter)
+        let env = s.environment
+        XCTAssertEqual(env["GGML_METAL_DEVICE_LIST"], "\(cards.expert),\(cards.drafter)",
+                       "the expert card first: Dynamic MoE plans the first card it sees")
+        XCTAssertNil(env["GGML_METAL_DEVICE_INDEX"])
+        let args = s.arguments
+        XCTAssertTrue(args.contains("--dynamic-moe"))
+        let md = try XCTUnwrap(args.firstIndex(of: "-md"))
