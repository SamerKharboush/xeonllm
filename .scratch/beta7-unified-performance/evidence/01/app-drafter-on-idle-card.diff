+    private func writeGGUF(_ url: URL, _ values: [(String, UInt32)], size: Int64) throws {
+        var data = Data("GGUF".utf8)
+        func u32(_ v: UInt32) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        func u64(_ v: UInt64) { withUnsafeBytes(of: v.littleEndian) { data.append(contentsOf: $0) } }
+        u32(3); u64(0); u64(UInt64(values.count))
+        for (key, value) in values {
+            u64(UInt64(key.utf8.count)); data.append(contentsOf: key.utf8); u32(4); u32(value)
+        }
+        try data.write(to: url)
+        let handle = try FileHandle(forWritingTo: url)
+        try handle.truncate(atOffset: UInt64(size))
+        try handle.close()
+    }
+
+    private func d700(_ index: Int, vramMB: Int = 6_144) -> GPUDevice {
+        GPUDevice(index: index, name: "AMD Radeon HD - FirePro D700", vramMB: vramMB)
+    }
+
+    /// The 35B Q6_K's size with a MoE header, and its 421 MB DFlash drafter beside it.
+    private func moeWithDrafter(gpus: [GPUDevice]) throws -> ServerSettings {
+        let dir = FileManager.default.temporaryDirectory
+            .appendingPathComponent("tosh-draft-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        addTeardownBlock { try? FileManager.default.removeItem(at: dir) }
+        let model = dir.appendingPathComponent("moe.gguf")
+        try writeGGUF(model, [("qwen35moe.block_count", 40), ("qwen35moe.expert_count", 256),
+                              ("qwen35moe.expert_used_count", 8)],
+                      size: Int64(26.56 * 1_073_741_824))
+        try writeGGUF(dir.appendingPathComponent("moe.dflash.gguf"),
+                      [("qwen3.block_count", 5), ("qwen3.attention.head_count_kv", 4),
+                       ("qwen3.attention.key_length", 128), ("qwen3.attention.value_length", 128)],
+                      size: 421_060_896)
+        ServerController.setGPUsForTesting(gpus)
+        addTeardownBlock { ServerController.setGPUsForTesting(nil) }
+        var s = makeSettings()
+        s.modelPath = model.path
+        s.multiGPU = true
+        s.ctx = 32_768
+        s.placement = s.resolvePlacement(on: d700HW)
+        return s
+    }
