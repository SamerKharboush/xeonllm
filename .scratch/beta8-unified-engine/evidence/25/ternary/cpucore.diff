+    static bool announced[GGML_TYPE_COUNT];
+    if (fn != NULL && !announced[type]) {
+        announced[type] = true;
+        fprintf(stderr, "ggml_cpu: multi-row dot ON for %s (AVX1)\n", ggml_type_name(type));
+    }
+    return fn;
+#endif
+    GGML_UNUSED(type);
+    return NULL;
+}
