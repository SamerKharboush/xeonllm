index 65d9f5da3..000000000
--- a/tests/test-sched-offload.cpp
+++ /dev/null
@@ -1,200 +0,0 @@
-// Checks that MUL_MAT with host-resident weights and a large batch is offloaded to the
-// accelerator by the scheduler, and that the result matches the same graph run on the host.
-//
-// build: cmake --build build --target test-sched-offload
-// run:   GGML_METAL_DEVICE_INDEX=0 ./bin/test-sched-offload
-
-#include "ggml.h"
-#include "ggml-alloc.h"
-#include "ggml-backend.h"
-
-#include <cmath>
-#include <cinttypes>
-#include <cstdio>
-#include <random>
-#include <string>
-#include <vector>
-
-static double nmse(const std::vector<float> & a, const std::vector<float> & b) {
-    double mse_ab = 0.0;
-    double mse_a0 = 0.0;
-    for (size_t i = 0; i < a.size(); i++) {
-        const double d = (double) a[i] - (double) b[i];
-        mse_ab += d*d;
-        mse_a0 += (double) a[i] * (double) a[i];
-    }
-    return mse_a0 > 0.0 ? mse_ab/mse_a0 : mse_ab;
-}
-
-static void init_weights(ggml_tensor * w, std::mt19937 & rng) {
-    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
-    const int64_t n = ggml_nelements(w);
-    std::vector<float> f(n);
-    for (auto & v : f) {
-        v = dist(rng);
-    }
-
-    if (w->type == GGML_TYPE_F32) {
-        ggml_backend_tensor_set(w, f.data(), 0, n*sizeof(float));
-    } else if (w->type == GGML_TYPE_F16) {
-        std::vector<ggml_fp16_t> h(n);
-        for (int64_t i = 0; i < n; i++) {
-            h[i] = ggml_fp32_to_fp16(f[i]);
-        }
-        ggml_backend_tensor_set(w, h.data(), 0, n*sizeof(ggml_fp16_t));
-    } else {
-        std::vector<char> q(ggml_nbytes(w));
-        ggml_quantize_chunk(w->type, f.data(), q.data(), 0, w->ne[1], w->ne[0], nullptr);
-        ggml_backend_tensor_set(w, q.data(), 0, q.size());
-    }
-}
-
-// Runs one MUL_MAT graph with the weights in host memory. Returns false on error.
-static bool run_case(
-        ggml_backend_t backend_accel, ggml_backend_t backend_host,
-        ggml_backend_buffer_type_t buft_accel, ggml_backend_buffer_type_t buft_host,
-        ggml_type type, int64_t K, int64_t N, int64_t M, bool op_offload,
-        std::vector<float> & out, std::string & out_backend) {
-    std::mt19937 rng(1234);
-
-    ggml_init_params ip = { 16u*1024u*1024u, nullptr, true };
-    ggml_context * ctx_w = ggml_init(ip);
-    ggml_context * ctx   = ggml_init(ip);
-
-    ggml_tensor * w = ggml_new_tensor_2d(ctx_w, type, K, N);
-    ggml_set_name(w, "w");
-
-    ggml_backend_buffer_t wbuf = ggml_backend_alloc_ctx_tensors(ctx_w, backend_host);
-    ggml_backend_buffer_set_usage(wbuf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
-    const bool host_weights = ggml_backend_buffer_is_host(wbuf);
-
-    init_weights(w, rng);
-
-    ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, M);
-    ggml_set_name(a, "a");
-    ggml_tensor * d = ggml_mul_mat(ctx, w, a);
-    ggml_set_name(d, "out");
-    ggml_set_output(d);
-
-    ggml_cgraph * gf = ggml_new_graph_custom(ctx, 64, false);
-    ggml_build_forward_expand(gf, d);
-
-    ggml_backend_t backends[2]               = { backend_accel, backend_host };
-    ggml_backend_buffer_type_t bufts[2]      = { buft_accel, buft_host };
-    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, bufts, 2, 64, false, op_offload);
-
-    const bool allocated = ggml_backend_sched_alloc_graph(sched, gf);
-
-    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
-    std::vector<float> fa(K*M);
-    for (auto & v : fa) {
-        v = dist(rng);
-    }
-    ggml_backend_tensor_set(a, fa.data(), 0, fa.size()*sizeof(float));
-
-    const bool computed = allocated && ggml_backend_sched_graph_compute(sched, gf) == GGML_STATUS_SUCCESS;
-    if (!allocated) {
-        fprintf(stderr, "test-sched-offload: alloc_graph failed (type %s, K=%" PRId64 ", N=%" PRId64 ", M=%" PRId64 ", offload=%d)\n",
-                ggml_type_name(type), K, N, M, (int) op_offload);
-    } else if (!computed) {
-        fprintf(stderr, "test-sched-offload: graph_compute failed (type %s, M=%" PRId64 ", offload=%d)\n",
-                ggml_type_name(type), M, (int) op_offload);
-    }
-
-    ggml_backend_t tb = ggml_backend_sched_get_tensor_backend(sched, d);
-    out_backend = tb ? ggml_backend_name(tb) : "?";
-
-    out.assign((size_t) (N*M), 0.0f);
-    if (computed) {
-        ggml_backend_tensor_get(d, out.data(), 0, out.size()*sizeof(float));
-    }
-
-    ggml_backend_sched_free(sched);
-    ggml_free(ctx);
-    ggml_backend_buffer_free(wbuf);
-    ggml_free(ctx_w);
-
-    if (!host_weights) {
-        fprintf(stderr, "test-sched-offload: weights are not in host memory\n");
-    }
-
-    return computed && host_weights;
-}
-
-int main() {
-    ggml_backend_load_all();
-
-    ggml_backend_dev_t dev_accel = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
-    ggml_backend_dev_t dev_host  = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
-    if (dev_accel == nullptr || dev_host == nullptr) {
-        printf("SKIP: need one GPU and one CPU backend\n");
-        return 0;
-    }
-
-    ggml_backend_t backend_accel = ggml_backend_dev_init(dev_accel, nullptr);
-    ggml_backend_t backend_host  = ggml_backend_dev_init(dev_host,  nullptr);
-
-    ggml_backend_buffer_type_t buft_accel = ggml_backend_get_default_buffer_type(backend_accel);
-    ggml_backend_buffer_type_t buft_host  = ggml_backend_get_default_buffer_type(backend_host);
-
-    printf("accel=%s host=%s\n", ggml_backend_dev_name(dev_accel), ggml_backend_dev_name(dev_host));
-
-    struct {
-        ggml_type type;
-        const char * name;
-    } cases[] = {
-        { GGML_TYPE_F32,  "f32"  },
-        { GGML_TYPE_F16,  "f16"  },
-        { GGML_TYPE_Q8_0, "q8_0" },
-        { GGML_TYPE_Q4_K, "q4_K" },
-        { GGML_TYPE_Q6_K, "q6_K" },
-    };
-
-    const int64_t K  = 2048;
-    const int64_t Ns[] = { 256, 2560, 8192 };
-    const int64_t Ms[] = { 1, 32, 128, 512 };
-
-    int n_fail = 0;
-
-    for (auto & c : cases) {
-        for (int64_t N : Ns) {
-        for (int64_t M : Ms) {
-            std::vector<float> ref;
-            std::vector<float> got;
-            std::string ref_backend;
-            std::string got_backend;
-
-            const bool ok_ref = run_case(backend_accel, backend_host, buft_accel, buft_host,
-                    c.type, K, N, M, false, ref, ref_backend);
-            const bool ok_got = run_case(backend_accel, backend_host, buft_accel, buft_host,
-                    c.type, K, N, M, true, got, got_backend);
-
-            if (!ok_ref || !ok_got) {
-                printf("%-5s N=%-4" PRId64 " M=%-4" PRId64 " ERROR (%s)\n", c.name, N, M,
-                        ok_ref ? "offload run failed" : "host run failed");
-                n_fail++;
-                continue;
-            }
-
-            const double err = nmse(ref, got);
-            const bool offloaded = got_backend != ref_backend;
-            const bool pass = err < 5e-4;
-
-            printf("%-5s N=%-4" PRId64 " M=%-4" PRId64 " offload=%-3s host=%-4s accel=%-4s nmse=%.3e %s\n",
-                    c.name, N, M, offloaded ? "yes" : "no", ref_backend.c_str(), got_backend.c_str(),
-                    err, pass ? "ok" : "FAIL");
-
-            if (!pass) {
-                n_fail++;
-            }
-        }
-        }
-    }
-
-    ggml_backend_free(backend_accel);
-    ggml_backend_free(backend_host);
-
-    printf("%s: %d failure(s)\n", n_fail == 0 ? "SUCCESS" : "FAILED", n_fail);
-
-    return n_fail == 0 ? 0 : 1;
-}
