+// Prefetch of the weight (x) stream with the non-temporal hint.
+// TOSH_CPU_NTA_DIST is the distance in bytes, rounded down to whole blocks. 0 turns the prefetch off.
+static inline int tosh_nta_dist(void) {
+    static int dist = -1;
+    if (dist < 0) {
+        const char * e = getenv("TOSH_CPU_NTA_DIST");
+        dist = e ? atoi(e) : 512;
+        if (dist < 0) {
+            dist = 0;
+        }
+        fprintf(stderr, "ggml_cpu: weight prefetch distance %d bytes%s\n", dist, dist > 0 ? "" : " (off)");
+    }
+    return dist;
+}
+
+static inline int tosh_nta_blocks(size_t block_size) {
+    const int bytes = tosh_nta_dist();
+    return bytes > 0 ? (int) (bytes / block_size) : 0;
+}
+
+// prefetch every cache line of the range, the blocks are not line aligned
+static inline void tosh_nta_prefetch(const void * p, size_t size) {
+    const uintptr_t begin = (uintptr_t) p & ~(uintptr_t) 63;
+    const uintptr_t end   = (uintptr_t) p + size;
+    for (uintptr_t a = begin; a < end; a += 64) {
+        _mm_prefetch((const char *) a, _MM_HINT_NTA);
+    }
+}
